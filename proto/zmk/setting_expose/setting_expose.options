# Nanopb options file for setting_expose.proto
# Key size: SETTINGS_MAX_NAME_LEN (64) + SETTINGS_EXTRA_LEN (9) + 1 null = 74, rounded to 80
zmk.setting_expose.SettingEntry.key             max_size:80
# oneof bytes / string value fields
zmk.setting_expose.SettingEntry.bytes_value     max_size:256
zmk.setting_expose.SettingEntry.string_value    max_size:256
# Use callback for repeated entries to avoid large static buffer
zmk.setting_expose.ListResponse.entries         type:FT_CALLBACK

zmk.setting_expose.ReadRequest.key              max_size:80
zmk.setting_expose.ReadResponse.key             max_size:80
zmk.setting_expose.ReadResponse.bytes_value     max_size:256
zmk.setting_expose.ReadResponse.string_value    max_size:256

zmk.setting_expose.WriteRequest.key             max_size:80
zmk.setting_expose.WriteRequest.bytes_value     max_size:256
zmk.setting_expose.WriteRequest.string_value    max_size:256

zmk.setting_expose.DeleteRequest.key            max_size:80

zmk.setting_expose.ErrorResponse.message        max_size:64

# Notification.payload carries an encoded Response relayed from a split half.
# Sized to hold one maximum SettingEntry (key 80 + value 256 + framing) so a
# single-entry list page or a full read always fits; keep in sync with the
# relay reply buffer (SE_RELAY_REPLY_DATA_MAX in include/zmk/setting_expose/relay.h).
zmk.setting_expose.Notification.payload         max_size:480
