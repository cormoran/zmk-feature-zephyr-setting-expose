# Nanopb options file for setting_expose.proto

# SettingEntry is the single key+value carrier (read/write/list).
# Key size: SETTINGS_MAX_NAME_LEN (64) + SETTINGS_EXTRA_LEN (9) + 1 null = 74, rounded to 80.
zmk.setting_expose.SettingEntry.key             max_size:80
zmk.setting_expose.SettingEntry.bytes_value     max_size:256
zmk.setting_expose.SettingEntry.string_value    max_size:256

# Streamed synchronously as a callback so a large page needs no fixed buffer.
zmk.setting_expose.ListPage.entries             type:FT_CALLBACK

zmk.setting_expose.Read.key                     max_size:80
zmk.setting_expose.Delete.key                   max_size:80

zmk.setting_expose.Error.message                max_size:64
